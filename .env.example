# APIHub Environment Configuration Example
# Copy this file to .env for deployment

# Django Core Security Settings
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=apihub.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://apihub.example.com,http://localhost:8000

# Database Configuration (PostgreSQL URL format)
# Leave blank to fallback to SQLite for local testing
DATABASE_URL=postgresql://apihub_user:secure_password@localhost:5432/apihub_db

# Security & HTTPS Settings (Set to True in production with SSL)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
